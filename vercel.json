{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/coding-learning-hub/frontend/index.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/coding-learning-hub/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/coding-learning-hub/frontend/js/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "/coding-learning-hub/frontend/data/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/coding-learning-hub/frontend/assets/:path*"
    },
    {
      "source": "/components/:path*",
      "destination": "/coding-learning-hub/frontend/components/:path*"
    },
    {
      "source": "/pages/:path*",
      "destination": "/coding-learning-hub/frontend/pages/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/coding-learning-hub/frontend/:path*"
    }
  ]
}
